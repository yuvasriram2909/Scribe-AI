# Scribe-AI Client Environment Configuration

# Backend API Base URL (Leave blank for Vite proxy in development, or set to your deployed backend URL)
# Example for local development:
# VITE_API_BASE_URL=http://localhost:5000/api

# Example for production deployment (e.g. your new Render / Railway / Custom backend):
# VITE_API_BASE_URL=https://your-new-backend.onrender.com/api
