# Scribe AI Backend Environment Configuration

# Server Port
PORT=5000

# PostgreSQL Database Connection String (Render / Supabase / Neon / Local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/scribe_ai_db?schema=public"

# JSON Web Token Secret for Authentication & Sessions
JWT_SECRET="your-secure-jwt-secret-key-32-chars-minimum"

# AES-256-GCM Encryption Key for Stored OAuth Tokens at Rest
ENCRYPTION_KEY="your-32-byte-token-encryption-secret"

# Frontend Application URL (for CORS & OAuth Redirects)
FRONTEND_URL="https://scribe-ai-self.vercel.app"

# Backend Public URL (e.g. your new Render / Railway / Custom backend URL)
BACKEND_URL="https://your-new-backend.onrender.com"

# Single Google Cloud OAuth 2.0 Credentials for Multi-User Gmail API
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
# Note: GOOGLE_REDIRECT_URI can be set explicitly or defaults to: {BACKEND_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI="https://your-new-backend.onrender.com/api/auth/google/callback"

# Web Push Notification VAPID Configuration
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@scribe-ai.com"

# Google Gemini AI API Key for Email Generation
GEMINI_API_KEY="your-google-gemini-api-key"
