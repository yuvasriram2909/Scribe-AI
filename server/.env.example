# Scribe AI Backend Environment Configuration (Supabase PostgreSQL)

# Server Port
PORT=5000

# Supabase PostgreSQL Database Connection String
# 1. Direct Connection (Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# 2. Connection Pooler (Port 6543 - Recommended for serverless / pooled deployments):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional Direct Database URL (for Prisma migrations when using connection pooler)
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JSON Web Token Secret for Authentication & Sessions
JWT_SECRET="your-secure-jwt-secret-key-32-chars-minimum"

# AES-256-GCM Encryption Key for Stored OAuth Tokens at Rest
ENCRYPTION_KEY="your-32-byte-token-encryption-secret"

# Frontend Application URL (for CORS & OAuth Redirects)
FRONTEND_URL="https://scribe-ai-self.vercel.app"

# Backend Public URL (e.g. your deployed backend URL or http://localhost:5000)
BACKEND_URL="https://your-backend-api.onrender.com"

# Single Google Cloud OAuth 2.0 Credentials for Multi-User Gmail API
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-backend-api.onrender.com/api/auth/google/callback"

# Web Push Notification VAPID Configuration
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@scribe-ai.com"

# Google Gemini AI API Key for Email Generation
GEMINI_API_KEY="your-google-gemini-api-key"
